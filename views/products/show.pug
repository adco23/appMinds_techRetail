extends ../layouts/main

block content
  h1.title Detalle de producto
  p.subtitle Informacion general del modulo Product

  .box
    p
      strong ID:
      |  #{product._id.toString().slice(-6)}
    p
      strong Nombre:
      |  #{product.name}
    p
      strong Descripcion:
      |  #{product.description}
    p
      strong Precio:
      |  #{product.price}
    p
      strong Stock:
      |  #{product.stock}
    p
      strong Categoria:
      |  #{product.category}
    p
      strong Tienda:
      |  #{product.storeId && product.storeId.name ? product.storeId.name : 'Sin tienda'}
    p
      strong Estado:
      |  #{product.status}

  .buttons
    a.button.is-link(href=`/products/view${sim.query}`) Volver al listado
    a.button.is-warning(href=`/products/edit/${product._id}${sim.query}`) Editar producto
