extends ../layouts/main

block content
  .level
    .level-left
      .level-item
        div
          h1.title Lista de productos
          p.subtitle Visualización del módulo Producto

    .level-right
      .level-item
        a.button.is-primary(href=`/products/view/new${sim.query}`) Nuevo producto

  if products && products.length > 0
    .table-container
      table.table.is-striped.is-hoverable.is-fullwidth
        thead
          tr
            th ID
            th Nombre
            th Descripción
            th Precio
            th Stock
            th Cat.
            th Tienda
            th Estado
            th Acciones
        tbody
          each product in products
            tr
              td= product._id.toString().slice(-6)
              td= product.name
              td
                span(title=product.description)= product.description.length > 30 ? product.description.slice(0, 30) + '...' : product.description
              td= product.price
              td= product.stock
              td= product.category
              td= product.storeId && product.storeId.name ? product.storeId.name : (product.storeId ? product.storeId.toString().slice(-6) : 'Sin tienda')
              td= product.status
              td
                div(style="display:flex; gap:0.5rem; align-items:center; flex-wrap:nowrap;")
                  a.button.is-info.is-small(href=`/products/view/${product._id}${sim.query}`) Ver
                  a.button.is-warning.is-small(href=`/products/edit/${product._id}${sim.query}`) Editar
                  form(method="POST", action=`/products/delete/${product._id}${sim.query}`, style="margin:0;")
                    button.button.is-danger.is-small(type="submit", onclick="return confirm('Eliminar este producto?')") Eliminar
  else
    article.message.is-warning
      .message-body
        | No hay productos cargados para mostrar.
