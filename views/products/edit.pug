extends ../layouts/main

block content
  h1.title Editar Producto

  form(method="POST", action=`/products/edit/${product._id}${sim.query}`)
    .field
      label.label Nombre
      .control
        input.input(type="text", name="name", value=product.name, required)

    .field
      label.label Descripción
      .control
        textarea.textarea(name="description", required)= product.description

    .field
      label.label Precio
      .control
        input.input(type="number", name="price", value=product.price, required)

    .field
      label.label Stock
      .control
        input.input(type="number", name="stock", value=product.stock, required)

    .field
      label.label Categoría
      .control
        input.input(type="text", name="category", value=product.category, required)

    .field
      label.label Tienda
      .control
        .select.is-fullwidth
          select(name="storeId", required)
            option(value="", disabled, selected=!storeId) Seleccioná una tienda...
            each store in stores
              option(value=store._id, selected=storeId && store._id.toString() === storeId.toString())= store.name

    .field
      label.label Estado
      .control
        input.input(type="text", name="status", value=product.status, required)

    .field.is-grouped
      .control
        button.button.is-primary(type="submit") Guardar cambios
      .control
        a.button.is-light(href=`/products/view${sim.query}`) Cancelar
