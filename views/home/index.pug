extends ../layouts/main

block content
  h1.title Bienvenido a TechRetail Solutions SRL
  p.subtitle Gestioná comercios, órdenes y suscripciones desde una plataforma única.

  if currentUser
    .notification.is-success.is-light
      | Sesión iniciada como #{currentUser.firstName} #{currentUser.lastName} (#{currentUser.email}).

    if currentUser.role === 'commerce-admin' && currentUser.commerceId === null
      .notification.is-warning
        | Aún no tenés un comercio asociado.
        a.is-link.ml-3(href="/commerce-admin/create") Crear comercio

  else
    .columns.is-vcentered.mt-5
      .column.is-5
        .box
          h2.title.is-4 Acceso a la plataforma
          p.mb-4 Iniciá la sesión o creá una cuenta para acceder a las vistas protegidas.
          .buttons
            a.button.is-primary(href="/auth/login") Iniciar sesión
            a.button.is-link(href="/auth/register") Crear cuenta
      .column.is-7
        .content
          h3.title.is-5 Funcionalidades
          ul
            li Gestión de usuarios y comercios
            li Seguimiento de órdenes y transacciones
            li Administración de suscripciones del comercio

  if sim.isCommerceAdmin && !sim.subscribed
    .notification.is-warning
      | El admin del comercio primero debe pagar una suscripción para tener acceso a las funcionalidades.
    a.button.is-warning.mt-3(href="/commerce-admin/subscription?role=commerce-admin") Ir a pagar suscripción

  if sim.isCommerceAdmin && sim.subscribed
    .notification.is-success
      | Suscripción activada. Ya podés entrar a los módulos del comercio.

  if sim.isPlatformAdmin
    .notification.is-info
      | Simulación de admin de plataforma activa.
