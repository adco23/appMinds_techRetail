extends ../layouts/main

block content
  h1.title Nueva tienda

  form(method="POST", action=`/stores/view${sim.query}`)

    .field
      label.label Nombre
      .control
        input.input(type="text", name="name", required)

    .field
      label.label Rubro
      .control
        input.input(type="text", name="category", required)

    .field
      label.label Subdominio
      .control
        input.input(type="text", name="subdomain", required)

    .field
      label.label Estado
      .control
        div.select.is-fullwidth
          select(name="status" required)
            option(value="active") Activa
            option(value="inactive") Inactiva

    if sim.isPlatformAdmin
      .field
        label.label Comercio
        .control
          div.select.is-fullwidth
            select(name="commerceId" required)
              option(value="") Seleccioná un comercio
              each commerce in commerces
                option(value=`${commerce._id}`)= commerce.name
    else
      input(type="hidden", name="commerceId", value=user && user.commerceId ? user.commerceId : '')

    .field
      label.label Fecha de creación
      .control
        input.input(type="date", name="createdAt", required)

    .field.is-grouped
      .control
        button.button.is-primary(type="submit") Guardar
      .control
        a.button.is-light(href=`/stores/view${sim.query}`) Cancelar
