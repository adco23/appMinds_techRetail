extends ../layouts/main

block content
  h1.title Editar tienda

  form(method="POST", action=`/stores/edit/${store.id}${sim.query}`)
    .field
      label.label Nombre
      .control
        input.input(type="text", name="name", value=store.name, required)

    .field
      label.label Rubro
      .control
        input.input(type="text", name="category", value=store.category, required)

    .field
      label.label Subdominio
      .control
        input.input(type="text", name="subdomain", value=store.subdomain, required)

    .field
      label.label Estado
      .control
        input.input(type="text", name="status", value=store.status, required)

    .field
      label.label Comercio
      .control
        input.input(
          type="text",
          value=(store.commerceId && store.commerceId.name ? store.commerceId.name : 'Sin comercio asignado'),
          readonly
        )
        input(
          type="hidden",
          name="commerceId",
          value=(store.commerceId && store.commerceId._id ? store.commerceId._id.toString() : store.commerceId)
        )

    .field
      label.label Fecha de creación
      .control
        input.input(
          type="text",
          value=(store.createdAt ? new Date(store.createdAt).toLocaleDateString('es-AR') : ''),
          readonly
        )

    .field.is-grouped
      .control
        button.button.is-primary(type="submit") Guardar cambios
      .control
        a.button.is-light(href=`/stores/view${sim.query}`) Cancelar