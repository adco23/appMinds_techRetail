extends ../layouts/main

block content
  .level
    .level-left
      .level-item
        div
          h1.title Lista de tiendas
          p.subtitle Visualización del módulo Tienda

    .level-right
      .level-item
        a.button.is-primary(href=`/stores/view/new${sim.query}`) Nueva tienda

  if stores && stores.length > 0
    .table-container
      table.table.is-striped.is-hoverable.is-fullwidth
        thead
          tr
            th ID
            th Nombre
            th Rubro
            th Subdominio
            th Estado
            th Comercio ID
            th Fecha de creación
            th Acciones
        tbody
          each store in stores
            tr
              td= store._id.toString().slice(-6)
              td= store.name
              td= store.category
              td= store.subdomain
              td= store.status
              td= store.commerceId && store.commerceId.name ? store.commerceId.name : (store.commerceId ? store.commerceId.toString().slice(-6) : 'Sin tienda')
              td= store.createdAt ? new Date(store.createdAt).toLocaleDateString('es-AR') : ''
              td
                div(style="display:flex; gap:0.5rem; align-items:center; flex-wrap:nowrap;")
                  a.button.is-info.is-small(href=`/stores/view/${store.id}${sim.query}`) Ver
                  a.button.is-warning.is-small(href=`/stores/edit/${store.id}${sim.query}`) Editar
                  form(method="POST", action=`/stores/delete/${store.id}${sim.query}`, style="margin:0;")
                    button.button.is-danger.is-small(type="submit", onclick="return confirm('Eliminar esta tienda?')") Eliminar
  else
    article.message.is-warning
      .message-body
        | No hay tiendas cargadas para mostrar.
