.box
  h2.title.is-5 Inicio de sesión

  form(method="POST", action="/auth/login")
    .field
      label.label Correo
      .control
        input.input(type="email", placeholder="Ingrese su correo", name="email", autocomplete="off", required)

    .field
      label.label Contraseña
      .control
        input.input(type="password", placeholder="Ingrese su contraseña", name="password", autocomplete="off", required)

  .buttons.mt-4
    button.button.is-primary(type="submit") Iniciar sesión
    a.is-link(href="/view/auth/register") Registrarse
