extends ../layouts/main.pug

block content
  h1.title Suscripciones

  h2.subtitle.mt-4 Planes disponibles

  .columns.is-variable.is-4.mb-6.is-multiline
    each plan in planes
      .column.is-4-desktop.is-6-tablet.is-12-mobile
        .card
          header.card-header.has-background-light
            p.card-header-title.is-centered.is-size-7= plan.name
          .card-content.p-3
            .content.has-text-centered
              p.is-size-4.has-text-weight-bold.mb-1 $#{Number(plan.precio).toLocaleString('es-AR')}
              p.has-text-grey.is-size-7 Período mínimo: #{plan.minimo}
          .card-footer(style="display:flex; border-top: 1px solid #ededed;")
              a(href=`/subscriptions/new${sim.query}&planId=${plan._id}` style="flex:1; text-align:center; padding:0.75rem; color:#48c78e; font-weight:500;") Elegir
              a(href=`/planes/edit/${plan._id}${sim.query}` style="flex:1; text-align:center; padding:0.75rem; color:#f0a500; font-weight:500; border-left:1px solid #ededed; border-right:1px solid #ededed;") Editar
              a(href=`/planes/delete/${plan._id}${sim.query}` style="flex:1; text-align:center; padding:0.75rem; color:#f14668; font-weight:500;") Eliminar

  .buttons.mt-5
    a.button.is-primary.is-rounded(href=`/planes/new${sim.query}`)
      span Nuevo Plan
    button.button.is-info.is-rounded(onclick="toggleLista()")
      span Ver suscripciones de tiendas

  #lista-suscripciones(style="display:none")
    hr
    h2.subtitle.mt-4 Suscripciones de tiendas

    table.table.is-fullwidth.is-striped.is-hoverable
      thead
        tr
          th Plan
          th Tienda
          th Monto
          th Estado
          th Inicio
          th Vencimiento
          th Acciones
      tbody
        each sub in subscriptions.filter(s => s.status === 'Activa' || s.status === 'active')
          tr
            td= sub.detail
            td= sub.storeId && sub.storeId.name ? sub.storeId.name : (sub.storeId ? sub.storeId.toString().slice(-6) : 'Sin tienda')
            td $#{Number(sub.amount).toLocaleString('es-AR')}
            td
              span.tag.is-success Activa
            td= sub.startDate
            td= sub.expDate
            td
              a.button.is-small.is-info.mr-1(href=`/subscriptions/renew/${sub._id}${sim.query}`) Renovar
              a.button.is-small.is-warning.mr-1(href=`/subscriptions/cancel/${sub._id}${sim.query}`) Cancelar
              a.button.is-small.is-danger(href=`/subscriptions/delete/${sub._id}${sim.query}`) Eliminar
        each sub in subscriptions.filter(s => s.status === 'Cancelada' || s.status === 'cancelled')
          tr.has-background-light
            td= sub.detail
            td= sub.storeId && sub.storeId.name ? sub.storeId.name : (sub.storeId ? sub.storeId.toString().slice(-6) : 'Sin tienda')
            td $#{Number(sub.amount).toLocaleString('es-AR')}
            td
              span.tag.is-danger Cancelada
            td= sub.startDate
            td= sub.expDate
            td
              a.button.is-small.is-info.mr-1(href=`/subscriptions/renew/${sub._id}${sim.query}`) Renovar
              a.button.is-small.is-danger(href=`/subscriptions/delete/${sub._id}${sim.query}`) Eliminar

  script.
    function toggleLista() {
      const lista = document.getElementById('lista-suscripciones');
      lista.style.display = lista.style.display === 'none' ? 'block' : 'none';
    }
