extends ../layouts/main.pug

block content
  h1.title Suscripciones disponibles

  if sim.isCommerceAdmin
    p.mt-3 Antes de acceder a órdenes, tiendas, productos y transacciones, tenés que crear una suscripción.

    if planes && planes.length
      .columns.is-centered.is-variable.is-6.mt-4
        each plan in planes
          .column.is-4
            .card
              header.card-header.has-background-light
                p.card-header-title.is-centered= plan.name
              .card-content
                .content.has-text-centered
                  p.is-size-3.has-text-weight-bold $#{Number(plan.precio).toLocaleString('es-AR')}
                  p.has-text-grey.is-size-7 Período mínimo: #{plan.minimo}
              footer.card-footer
                a.card-footer-item.button.is-primary(href=`/commerce-admin/subscription/tienda?planId=${plan._id}&role=commerce-admin`) Elegir plan
    else
      .notification.is-warning.mt-4
        p Todavía no hay planes disponibles. Un administrador de plataforma debe cargarlos antes de que puedas suscribirte.

    .buttons.mt-4
      a.button.is-light(href="/?role=commerce-admin") Volver

  else
    a.button.is-light.mt-3(href="/") Volver al inicio
