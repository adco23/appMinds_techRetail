extends ../layouts/main.pug

block content
  h1.title Editar Plan

  .box
    form(action=`/plans/edit/${plan._id}${sim.query}` method="POST")

      .field
        label.label Nombre
        .control
          input.input(type="text" name="name" value=plan.name required)

      .field
        label.label Precio
        .control
          input.input(type="number" name="price" value=plan.price required)

      .field
        label.label Comisión
        .control
          input.input(type="number" name="commission" value=plan.commission required)

      .field
        label.label Período mínimo
        .control
          input.input(type="text" name="minimum" value=plan.minimum required)

      .buttons.mt-4
        button.button.is-primary(type="submit") Guardar cambios
        a.button.is-light(href=`/subscriptions${sim.query}`) Cancelar
