extends ../layouts/main.pug

block content
  h1.title Nuevo Plan

  .box
    form(action=`/plans/create${sim.query}` method="POST")

      .field
        label.label Nombre
        .control
          input.input(type="text" name="name" placeholder="Ej: Básico" required)

      .field
        label.label Precio
        .control
          input.input(type="number" name="price" placeholder="50000" required)

      .field
        label.label Comisión
        .control
          input.input(type="number" name="commission" step="any" placeholder="0,05" required)

      .field
        label.label Período mínimo
        .control
          input.input(type="text" name="minimum" placeholder="Ej: 1 mes" required)

      .buttons.mt-4
        button.button.is-primary(type="submit") Guardar plan
        a.button.is-light(href=`/subscriptions${sim.query}`) Cancelar
