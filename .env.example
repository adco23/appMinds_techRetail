# Conexión a MongoDB Atlas
# Reemplazar usuario, password y cluster con los valores reales
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/TechRetail?appName=appMinds

# Clave secreta para firmar las sesiones — usar un string largo y aleatorio en producción
SESSION_SECRET=cambiar_por_un_string_secreto_largo

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
